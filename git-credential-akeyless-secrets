#!/bin/bash
set -eu
# Git credential helper: reads HTTPS URLs (one per line) from an Akeyless static secret.
# Expects AKEYLESS_TOKEN (and plugin auth env) to be exported by hooks/environment.

_action="${1:-get}"
if [[ "$_action" != "get" ]]; then
  exit 0
fi

_source="${BASH_SOURCE[0]}"
[ -z "${_source:-}" ] && _source="${0}"
_basedir="$( cd "$( dirname "${_source}" )" && pwd )"

_bin="${_basedir}/bin/akeyless-bk-secrets"
if [[ ! -x "$_bin" ]]; then
  _bin="$(command -v akeyless-bk-secrets || true)"
fi
if [[ -z "$_bin" || ! -x "$_bin" ]]; then
  echo "+++ :warning: akeyless-bk-secrets binary not found (run: make build)" >&2
  exit 1
fi

: "${AKEYLESS_GIT_CREDENTIAL_SECRET:?AKEYLESS_GIT_CREDENTIAL_SECRET is not set}"

exec "$_bin" git-credential "$AKEYLESS_GIT_CREDENTIAL_SECRET"
